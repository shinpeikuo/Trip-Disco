rules_version = '2';
// Paste this into Firebase console -> Firestore Database -> Rules, then Publish.
// A trip can only be opened by someone who knows its 16-character code (the document ID).
// Nobody can list all trips, so codes cannot be discovered.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{code} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && code.size() >= 16;
      allow list, delete: if false;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
